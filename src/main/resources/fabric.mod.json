{
  "schemaVersion": 1,
  "id": "totem-automata",
  "version": "${version}",
  "name": "TotemAutomata",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.totem.automata.TotemAutomata"],
    "client": ["dev.totem.automata.client.TotemAutomataClient"]
  },
  "mixins": [
    "totem-automata.mixins.json",
    {
      "config": "totem-automata.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25",
    "totem-core": "*"
  }
}
